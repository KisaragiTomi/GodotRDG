+RDD::TextureID RenderingDeviceDriverVulkan::texture_create_placed(const TextureFormat &p_format, const TextureView &p_view, MemoryHeapID p_heap, uint64_t p_offset) {
+	ERR_FAIL_COND_V_MSG(p_format.usage_bits & (TEXTURE_USAGE_CPU_READ_BIT | TEXTURE_USAGE_TRANSIENT_BIT), TextureID(), "CPU-readable and transient textures can't be placed in a memory heap.");
+	const MemoryHeapInfo *heap_info = (const MemoryHeapInfo *)p_heap.id;
+	ERR_FAIL_NULL_V(heap_info, TextureID());
+
+	VkImageCreateInfo create_info = {};
+	VkImageFormatListCreateInfoKHR format_list_create_info = {};
+	LocalVector<VkFormat> allowed_formats;
+	_texture_fill_image_create_info(p_format, create_info, format_list_create_info, allowed_formats);
+
+	VkImage vk_image = VK_NULL_HANDLE;
+	VkResult err = vkCreateImage(vk_device, &create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE), &vk_image);
+	ERR_FAIL_COND_V_MSG(err, TextureID(), "vkCreateImage failed with error " + itos(err) + ".");
+
+	VkMemoryRequirements memory_requirements = {};
+	vkGetImageMemoryRequirements(vk_device, vk_image, &memory_requirements);
+	if (!(memory_requirements.memoryTypeBits & (1u << placed_memory_type_index)) || (p_offset % memory_requirements.alignment) != 0 || p_offset + memory_requirements.size > heap_info->size) {
+		vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+		ERR_FAIL_V_MSG(TextureID(), vformat("Texture of %d bytes can't be placed at offset %d of a %d bytes memory heap.", memory_requirements.size, p_offset, heap_info->size));
+	}
+
+	err = vmaBindImageMemory2(allocator, heap_info->allocation, p_offset, vk_image, nullptr);
+	if (err) {
+		vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+		ERR_FAIL_V_MSG(TextureID(), "vmaBindImageMemory2 failed with error " + itos(err) + ".");
+	}
+
+	VkImageViewCreateInfo image_view_create_info = {};
+	VkImageView vk_image_view = VK_NULL_HANDLE;
+	err = _texture_create_view(vk_image, p_format, p_view, create_info, image_view_create_info, vk_image_view);
+	if (err) {
+		vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+		ERR_FAIL_V_MSG(TextureID(), "vkCreateImageView failed with error " + itos(err) + ".");
+	}
+
+	// The memory belongs to the heap: allocation stays null and texture_free() only destroys the image.
+	TextureInfo *tex_info = VersatileResource::allocate<TextureInfo>(resources_allocator);
+	tex_info->vk_image = vk_image;
+	tex_info->vk_view = vk_image_view;
+	tex_info->rd_format = p_format.format;
+	tex_info->vk_create_info = create_info;
+	tex_info->vk_create_info.pNext = nullptr;
+	tex_info->vk_view_create_info = image_view_create_info;
+	tex_info->placed = true;
+
+#if PRINT_NATIVE_COMMANDS
+	print_line(vformat("vkCreateImageView: 0x%uX for placed 0x%uX at offset %d", uint64_t(vk_image_view), uint64_t(vk_image), p_offset));
+#endif
+
+	return TextureID(tex_info);
+}
