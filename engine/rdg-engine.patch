+	Callback callback;
+	callback.callback = p_callback;
+	callback.object = p_object;
+	callback.data = p_data;
+
+	Operation operation;
+	operation.type = OPERATION_CALLBACK;
+	operation.index = callbacks.size();
+	callbacks.push_back(callback);
+	operations.push_back(operation);
+}
+
+void RenderingDeviceGraph::RecordingContext::clear() {
+	operations.clear();
+	compute_list_count = 0;
+	draw_list_count = 0;
+	label_chars.clear();
+	labels.clear();
+	aliasing_acquire_count = 0;
+	callbacks.clear();
+}
+
+void RenderingDeviceGraph::set_recording_context(RecordingContext *p_context) {
+	if (p_context != nullptr) {
+		p_context->graph = this;
+	}
+
+	current_recording_context = p_context;
+}
+
+RenderingDeviceGraph::RecordingContext *RenderingDeviceGraph::get_recording_context() const {
+	return _get_recording_context();
+}
+
+void RenderingDeviceGraph::submit_recording_context(RecordingContext *p_context) {
+	ERR_FAIL_NULL(p_context);
+	ERR_FAIL_COND_MSG(p_context->graph != nullptr && p_context->graph != this, "The recording context was recorded for another graph.");
+	ERR_FAIL_COND_MSG(current_recording_context != nullptr, "A recording context can't be submitted from a thread that is recording into one.");
+
+	for (const RecordingContext::Operation &operation : p_context->operations) {
+		switch (operation.type) {
+			case RecordingContext::OPERATION_COMPUTE_LIST: {
+				_add_compute_list_end(p_context->compute_lists[operation.index]);
+			} break;
+			case RecordingContext::OPERATION_DRAW_LIST: {
+				_add_draw_list_end(p_context->draw_lists[operation.index]);
+			} break;
+			case RecordingContext::OPERATION_BEGIN_LABEL: {
+				const RecordingContext::Label &label = p_context->labels[operation.index];
+				begin_label(Span<char>(p_context->label_chars.ptr() + label.offset, label.size), label.color);
+			} break;
+			case RecordingContext::OPERATION_END_LABEL: {
+				end_label();
+			} break;
+			case RecordingContext::OPERATION_ALIASING_ACQUIRE: {
+				RecordingContext::AliasingAcquire &acquire = p_context->aliasing_acquires[operation.index];
+				add_aliasing_acquire(acquire.tracker, acquire.overlapping_trackers);
+			} break;
+			case RecordingContext::OPERATION_CALLBACK: {
+				const RecordingContext::Callback &callback = p_context->callbacks[operation.index];
+				callback.callback(callback.object, callback.data);
+			} break;
+		}
+	}
+
+	p_context->clear();
+}
+
+RDD::CommandBufferID RenderingDeviceGraph::_command_buffer_pool_begin_next(CommandBufferPool &r_command_buffer_pool) {
+	while (r_command_buffer_pool.buffers_used >= r_command_buffer_pool.buffers.size()) {
+		r_command_buffer_pool.buffers.push_back(driver->command_buffer_create(r_command_buffer_pool.pool));
+		r_command_buffer_pool.semaphores.push_back(driver->semaphore_create());
+	}
+
+	RDD::CommandBufferID command_buffer = r_command_buffer_pool.buffers[r_command_buffer_pool.buffers_used++];
+	driver->command_buffer_begin(command_buffer);
+	return command_buffer;
+}
+
+uint32_t RenderingDeviceGraph::_get_command_translate_cost(const RecordedCommand *p_command) const {
+	// About one per driver call: lists count the instructions they recorded (32 bytes is an average instruction).
+	switch (p_command->type) {
+		case RecordedCommand::TYPE_COMPUTE_LIST:
+			return 1 + reinterpret_cast<const RecordedComputeListCommand *>(p_command)->instruction_data_size / 32;
+		case RecordedCommand::TYPE_DRAW_LIST:
+			return 2 + reinterpret_cast<const RecordedDrawListCommand *>(p_command)->instruction_data_size / 32;
+		default:
+			return 1;
+	}
+}
+
+uint32_t RenderingDeviceGraph::_get_parallel_translate_chunk_count(const RecordedCommandSort *p_sorted_commands, VectorView<Pair<uint32_t, uint32_t>> p_main_batches, const ParallelTranslate &p_parallel_translate) {
+	const uint32_t max_tasks = MIN(p_parallel_translate.max_tasks, p_parallel_translate.pools.size());
+	if (!p_parallel_translate.enabled || p_parallel_translate.max_commands_per_translate == 0 || max_tasks == 0 || device.workarounds.avoid_compute_after_draw) {
+		// The compute after draw workaround splits command buffers while recording, which needs the serial order.
+		return 0;
+	}
+
+	translate_command_costs.resize(command_count);
+	translate_total_cost = 0;
+	for (uint32_t batch_index = 0; batch_index < p_main_batches.size(); batch_index++) {
+		const Pair<uint32_t, uint32_t> &batch = p_main_batches[batch_index];
+		for (uint32_t i = batch.first; i < batch.second; i++) {
+			const int32_t command_index = p_sorted_commands[i].index;
+			const uint32_t cost = _get_command_translate_cost(reinterpret_cast<const RecordedCommand *>(&command_data[command_data_offsets[command_index]]));
+			translate_command_costs[command_index] = cost;
+			translate_total_cost += cost;
+		}
+	}
+
+	// Chunks recorded by the render thread and the worker tasks, each one about the same amount of work.
+	uint64_t chunk_count = max_tasks + 1;
+	if (p_parallel_translate.max_commands_per_translate > 0) {
+		chunk_count = MIN(chunk_count, (translate_total_cost + p_parallel_translate.max_commands_per_translate - 1) / uint64_t(p_parallel_translate.max_commands_per_translate));
+	}
+
+	return chunk_count;
+}
+
+bool RenderingDeviceGraph::_plan_parallel_translate(RecordedCommandSort *r_sorted_commands, VectorView<Pair<uint32_t, uint32_t>> p_main_batches, uint32_t p_chunk_count, bool p_reorder_commands, bool p_full_barriers, uint32_t p_first_main_command_buffer, ParallelTranslate &r_parallel_translate) {
+	translate_chunks.clear();
+	translate_task_count = 0;
+	if (p_chunk_count <= 1) {
+		return false;
+	}
+
+	const uint32_t max_tasks = MIN(r_parallel_translate.max_tasks, r_parallel_translate.pools.size());
+	const uint64_t chunk_count = p_chunk_count;
+	const uint64_t total_cost = translate_total_cost;
+	const LocalVector<uint32_t> &command_costs = translate_command_costs;
+	for (CommandBufferPool &pool : r_parallel_translate.pools) {
+		// The frame's previous command buffers were waited for when the frame began.
+		pool.buffers_used = 0;
+	}
+
+	if (p_reorder_commands) {
+		// The serial path boosts priorities level by level while recording, it only depends on the previous levels.
+		for (uint32_t batch_index = 0; batch_index < p_main_batches.size(); batch_index++) {
+			const Pair<uint32_t, uint32_t> &batch = p_main_batches[batch_index];
+			uint32_t boosted_priority = 0;
+			uint32_t level_start = batch.first;
+			for (uint32_t i = batch.first + 1; i <= batch.second; i++) {
+				if (i < batch.second && r_sorted_commands[i].level == r_sorted_commands[level_start].level) {
+					continue;
+				}
+
+				_boost_priority_for_render_commands(&r_sorted_commands[level_start], i - level_start, boosted_priority);
+				level_start = i;
+			}
+		}
+	}
+
+	// Cut the commands of every main queue command buffer (a batch, split again before draw lists that ask for their own
+	// command buffer) into chunks. The first chunk is recorded into the main queue command buffer by the render thread.
+	uint32_t main_command_buffer = p_first_main_command_buffer;
+	uint32_t next_task = 0;
+	for (uint32_t batch_index = 0; batch_index < p_main_batches.size(); batch_index++) {
+		const Pair<uint32_t, uint32_t> &batch = p_main_batches[batch_index];
+		if (batch_index > 0) {
+			main_command_buffer++;
+		}
+
+		uint32_t segment_start = batch.first;
+		while (segment_start < batch.second) {
+			uint32_t segment_end = segment_start + 1;
+			uint64_t segment_cost = command_costs[r_sorted_commands[segment_start].index];
+			while (segment_end < batch.second) {
+				const RecordedCommand *command = reinterpret_cast<const RecordedCommand *>(&command_data[command_data_offsets[r_sorted_commands[segment_end].index]]);
+				if (command->type == RecordedCommand::TYPE_DRAW_LIST && reinterpret_cast<const RecordedDrawListCommand *>(command)->split_cmd_buffer) {
+					break;
+				}
+
+				segment_cost += command_costs[r_sorted_commands[segment_end].index];
+				segment_end++;
+			}
+
+			const RecordedCommand *first_command = reinterpret_cast<const RecordedCommand *>(&command_data[command_data_offsets[r_sorted_commands[segment_start].index]]);
+			if (first_command->type == RecordedCommand::TYPE_DRAW_LIST && reinterpret_cast<const RecordedDrawListCommand *>(first_command)->split_cmd_buffer) {
+				// Same as the serial path: the draw list starts a new main queue command buffer.
+				main_command_buffer++;
+			}
+
+			const uint64_t segment_chunk_count = CLAMP((segment_cost * chunk_count + total_cost / 2) / total_cost, uint64_t(1), uint64_t(segment_end - segment_start));
+			uint64_t chunk_cost = 0;
+			uint32_t chunk_start = segment_start;
+			uint32_t segment_chunk = 0;
+			for (uint32_t i = segment_start; i < segment_end; i++) {
+				chunk_cost += command_costs[r_sorted_commands[i].index];
+				if (i + 1 < segment_end && (segment_chunk + 1 == segment_chunk_count || chunk_cost * segment_chunk_count < segment_cost * (segment_chunk + 1))) {
+					continue;
+				}
+
+				TranslateChunk chunk;
+				chunk.start = chunk_start;
+				chunk.end = i + 1;
+				chunk.batch_start = batch.first;
+				chunk.batch_end = batch.second;
+				chunk.main_command_buffer = main_command_buffer;
+				if (segment_chunk > 0) {
+					chunk.task = next_task;
+					next_task = (next_task + 1) % max_tasks;
+					translate_task_count = MAX(translate_task_count, uint32_t(chunk.task) + 1);
+				}
+
+				translate_chunks.push_back(chunk);
+				chunk_start = i + 1;
+				segment_chunk++;
+			}
+
+			segment_start = segment_end;
+		}
+	}
+
+	if (translate_task_count == 0) {
+		return false;
+	}
+
+	// Render passes and framebuffers are created on the render thread: the tasks only look them up.
+	for (uint32_t batch_index = 0; batch_index < p_main_batches.size(); batch_index++) {
+		const Pair<uint32_t, uint32_t> &batch = p_main_batches[batch_index];
+		for (uint32_t i = batch.first; i < batch.second; i++) {
+			const RecordedCommand *command = reinterpret_cast<const RecordedCommand *>(&command_data[command_data_offsets[r_sorted_commands[i].index]]);
+			const RecordedDrawListCommand *draw_list_command = reinterpret_cast<const RecordedDrawListCommand *>(command);
+			if (command->type == RecordedCommand::TYPE_DRAW_LIST && draw_list_command->framebuffer_cache != nullptr) {
+				RDD::RenderPassID render_pass;
+				RDD::FramebufferID framebuffer;
+				_get_draw_list_render_pass_and_framebuffer(draw_list_command, render_pass, framebuffer);
+			}
+		}
+	}
+
+	// Command buffers are created on the render thread too.
+	if (translate_tasks.size() < translate_task_count) {
+		translate_tasks.resize(translate_task_count);
+	}
+
+	for (uint32_t i = 0; i < translate_task_count; i++) {
+		translate_tasks[i].chunks.clear();
+	}
+
+	for (uint32_t i = 0; i < translate_chunks.size(); i++) {
+		TranslateChunk &chunk = translate_chunks[i];
+		if (chunk.task < 0) {
+			continue;
+		}
+
+		CommandBufferPool &pool = r_parallel_translate.pools[chunk.task];
+		if (pool.buffers_used >= pool.buffers.size()) {
+			pool.buffers.push_back(driver->command_buffer_create(pool.pool));
+		}
+
+		chunk.command_buffer = pool.buffers[pool.buffers_used++];
+		translate_tasks[chunk.task].chunks.push_back(i);
+	}
+
+	translate_full_barriers = p_full_barriers;
+	return true;
+}
+
+void RenderingDeviceGraph::_run_translate_chunk(RDD::CommandBufferID p_command_buffer, const RecordedCommandSort *p_sorted_commands, const TranslateChunk &p_chunk, BarrierGroup &r_barrier_group) {
+	// Every chunk opens and closes its own labels, a label that spans several chunks is split.
+	int32_t current_label_index = -1;
+	int32_t current_label_level = -1;
+	_run_label_command_change(p_command_buffer, -1, -1, true, true, nullptr, 0, current_label_index, current_label_level);
+
+	uint32_t level_start = p_chunk.start;
+	while (level_start < p_chunk.end) {
+		const uint32_t level = p_sorted_commands[level_start].level;
+		uint32_t level_end = level_start + 1;
+		while (level_end < p_chunk.batch_end && p_sorted_commands[level_end].level == level) {
+			level_end++;
+		}
+
+		if (level_start == p_chunk.batch_start || p_sorted_commands[level_start - 1].level != level) {
+			// The chunk starts the level: its barriers also cover the commands of the level in the next chunks, which are
+			// submitted after this command buffer.
+			_group_barriers_for_render_commands(p_command_buffer, &p_sorted_commands[level_start], level_end - level_start, translate_full_barriers, r_barrier_group);
+		}
+
+		const uint32_t run_end = MIN(level_end, p_chunk.end);
+		RDD::CommandBufferID command_buffer = p_command_buffer;
+		_run_render_commands(level, &p_sorted_commands[level_start], run_end - level_start, command_buffer, nullptr, current_label_index, current_label_level);
+		level_start = run_end;
+	}
+
+	_run_label_command_change(p_command_buffer, -1, -1, false, false, nullptr, 0, current_label_index, current_label_level);
+}
+
+void RenderingDeviceGraph::_run_translate_task(uint32_t p_task, const RecordedCommandSort *p_sorted_commands) {
+	TranslateTask &task = translate_tasks[p_task];
+	for (uint32_t chunk_index : task.chunks) {
+		const TranslateChunk &chunk = translate_chunks[chunk_index];
+		driver->command_buffer_begin(chunk.command_buffer);
+		_run_translate_chunk(chunk.command_buffer, p_sorted_commands, chunk, task.barrier_group);
+		driver->command_buffer_end(chunk.command_buffer);
+	}
+}
+
+WorkerThreadPool::GroupID RenderingDeviceGraph::_start_parallel_translate(const RecordedCommandSort *p_sorted_commands) {
+	return WorkerThreadPool::get_singleton()->add_template_group_task(this, &RenderingDeviceGraph::_run_translate_task, p_sorted_commands, translate_task_count, translate_task_count, true);
+}
+
+void RenderingDeviceGraph::_run_translate_head_chunks(const RecordedCommandSort *p_sorted_commands, uint32_t p_batch_start, RDD::CommandBufferID &r_command_buffer, CommandBufferPool &r_command_buffer_pool) {
+	for (const TranslateChunk &chunk : translate_chunks) {
+		if (chunk.batch_start != p_batch_start || chunk.task >= 0) {
+			continue;
+		}
+
+		// A draw list that asks for its own command buffer starts the chunk.
+		while (r_command_buffer_pool.buffers_used < chunk.main_command_buffer) {
+			driver->command_buffer_end(r_command_buffer);
+			r_command_buffer = _command_buffer_pool_begin_next(r_command_buffer_pool);
+		}
+
+		_run_translate_chunk(r_command_buffer, p_sorted_commands, chunk, barrier_group);
+	}
+}
+
+bool RenderingDeviceGraph::_run_parallel_translate(LocalVector<RecordedCommandSort> &r_commands_sorted, bool p_reorder_commands, bool p_full_barriers, RDD::CommandBufferID &r_command_buffer, CommandBufferPool &r_command_buffer_pool, ParallelTranslate &r_parallel_translate) {
+	// Without async compute, all the commands are one main queue batch.
+	const Pair<uint32_t, uint32_t> main_batch(0, command_count);
+	const uint32_t chunk_count = _get_parallel_translate_chunk_count(r_commands_sorted.ptr(), main_batch, r_parallel_translate);
+	if (chunk_count <= 1) {
+		return false;
+	}
+
+	if (p_reorder_commands) {
+		r_commands_sorted.sort();
+	} else {
+		for (uint32_t i = 0; i < command_count; i++) {
+			// Every command is recorded on its own with its barriers.
+			r_commands_sorted[i].level = i;
+		}
+	}
+
+	if (!_plan_parallel_translate(r_commands_sorted.ptr(), main_batch, chunk_count, p_reorder_commands, p_full_barriers, r_command_buffer_pool.buffers_used, r_parallel_translate)) {
+		// Nothing for the worker tasks: the serial path sorts and boosts the commands again, which doesn't change them.
+		return false;
+	}
+
+	const WorkerThreadPool::GroupID translate_group = _start_parallel_translate(r_commands_sorted.ptr());
+	_run_translate_head_chunks(r_commands_sorted.ptr(), 0, r_command_buffer, r_command_buffer_pool);
+	_finish_parallel_translate(translate_group, r_parallel_translate);
+	return true;
+}
+
+void RenderingDeviceGraph::_finish_parallel_translate(WorkerThreadPool::GroupID p_group, ParallelTranslate &r_parallel_translate) {
+	WorkerThreadPool::get_singleton()->wait_for_group_task_completion(p_group);
+
+	for (const TranslateChunk &chunk : translate_chunks) {
+		if (chunk.task >= 0) {
+			r_parallel_translate.command_buffers.push_back(chunk.command_buffer);
+			r_parallel_translate.main_command_buffers.push_back(chunk.main_command_buffer);
+		}
+	}
+
+	r_parallel_translate.task_count = translate_task_count;
+}
+
+void RenderingDeviceGraph::_run_queue_batches(LocalVector<RecordedCommandSort> &r_commands_sorted, bool p_reorder_commands, bool p_full_barriers, RDD::CommandBufferID &r_command_buffer, CommandBufferPool &r_command_buffer_pool, CommandBufferPool &r_async_compute_command_buffer_pool, AsyncComputeSubmissions &r_async_compute_submissions, ParallelTranslate *r_parallel_translate) {
+	// Sort the commands by batch (in submission order) first. Dependencies inside a batch keep their levels and barriers,
+	// dependencies on earlier batches are covered by the submission order (same queue) or by a semaphore (other queue).
+	for (uint32_t i = 0; i < command_count; i++) {
+		RecordedCommandSort &command_sort = r_commands_sorted[i];
+		const RecordedCommand *command = reinterpret_cast<const RecordedCommand *>(&command_data[command_data_offsets[command_sort.index]]);
+		command_sort.batch_order = queue_batches[command->queue_batch].order;
+		if (!p_reorder_commands) {
+			// Without reordering, every command is recorded on its own with its barriers.
+			command_sort.level = i;
+		}
+	}
+
+	r_commands_sorted.sort();
+
+	thread_local LocalVector<int32_t> batch_first_main_command_buffer;
+	thread_local LocalVector<int32_t> batch_last_main_command_buffer;
+	thread_local LocalVector<int32_t> batch_async_compute_submission;
+	batch_first_main_command_buffer.resize(queue_batches.size());
+	batch_last_main_command_buffer.resize(queue_batches.size());
+	batch_async_compute_submission.resize(queue_batches.size());
+	for (uint32_t i = 0; i < queue_batches.size(); i++) {
+		batch_first_main_command_buffer[i] = -1;
+		batch_last_main_command_buffer[i] = -1;
+		batch_async_compute_submission[i] = -1;
+	}
+
+	if (device.workarounds.avoid_compute_after_draw) {
+		// Reset the state of the workaround.
+		workarounds_state.draw_list_found = false;
+	}
+
+	// Range of every batch in the sorted commands.
+	thread_local LocalVector<Pair<uint32_t, uint32_t>> batch_ranges;
+	thread_local LocalVector<Pair<uint32_t, uint32_t>> main_batch_ranges;
+	batch_ranges.resize(queue_batch_order.size());
+	main_batch_ranges.clear();
+	uint32_t command_cursor = 0;
+	for (uint32_t order = 0; order < queue_batch_order.size(); order++) {
+		const uint32_t batch_start = command_cursor;
+		while (command_cursor < command_count && r_commands_sorted[command_cursor].batch_order == order) {
+			command_cursor++;
+		}
+
+		batch_ranges[order] = Pair<uint32_t, uint32_t>(batch_start, command_cursor);
+		if (queue_batches[queue_batch_order[order]].queue_type == COMMAND_QUEUE_TYPE_MAIN) {
+			main_batch_ranges.push_back(batch_ranges[order]);
+		}
+	}
+
+	// Worker tasks record most of the main queue batches while the render thread records the rest.
+	WorkerThreadPool::GroupID translate_group = -1;
+	if (r_parallel_translate != nullptr) {
+		const uint32_t chunk_count = _get_parallel_translate_chunk_count(r_commands_sorted.ptr(), main_batch_ranges, *r_parallel_translate);
+		if (_plan_parallel_translate(r_commands_sorted.ptr(), main_batch_ranges, chunk_count, p_reorder_commands, p_full_barriers, r_command_buffer_pool.buffers_used, *r_parallel_translate)) {
+			translate_group = _start_parallel_translate(r_commands_sorted.ptr());
+		}
+	}
+
+	r_async_compute_submissions.batches.resize(queue_batch_order.size());
+	for (uint32_t order = 0; order < queue_batch_order.size(); order++) {
+		const int32_t batch_index = queue_batch_order[order];
+		const QueueBatch &batch = queue_batches[batch_index];
+		const bool async_compute = batch.queue_type == COMMAND_QUEUE_TYPE_ASYNC_COMPUTE;
+		const uint32_t batch_start = batch_ranges[order].first;
+		command_cursor = batch_ranges[order].second;
+
+		// Main batch 0 is always closed first and uses the frame's command buffer. Every other batch gets a command buffer
+		// of its own so it can be submitted after the batches of the other queue it waits for.
+		RDD::CommandBufferID async_compute_command_buffer;
+		if (async_compute) {
+			async_compute_command_buffer = _command_buffer_pool_begin_next(r_async_compute_command_buffer_pool);
+			batch_async_compute_submission[batch_index] = r_async_compute_command_buffer_pool.buffers_used - 1;
+		} else {
+			if (batch_index != 0) {
+				driver->command_buffer_end(r_command_buffer);
+				r_command_buffer = _command_buffer_pool_begin_next(r_command_buffer_pool);
+			}
+
+			batch_first_main_command_buffer[batch_index] = r_command_buffer_pool.buffers_used;
+		}
+
+		RDD::CommandBufferID &command_buffer = async_compute ? async_compute_command_buffer : r_command_buffer;
+		CommandBufferPool &command_buffer_pool = async_compute ? r_async_compute_command_buffer_pool : r_command_buffer_pool;
+
+		// The compute after draw workaround only splits command buffers of the main queue.
+		const bool workaround_draw_list_found = workarounds_state.draw_list_found;
+		if (async_compute) {
+			workarounds_state.draw_list_found = false;
+		}
+
+		AsyncComputeSubmissions::Batch &batch_info = r_async_compute_submissions.batches[order];
+		batch_info.queue_type = batch.queue_type;
+		batch_info.wait_batch = batch.wait_batch >= 0 ? int32_t(queue_batches[batch.wait_batch].order) : -1;
+		batch_info.command_count = command_cursor - batch_start;
+		batch_info.labels.clear();
+
+		const uint32_t batch_command_count = command_cursor - batch_start;
+		if (batch_command_count > 0) {
+			RecordedCommandSort *batch_commands = &r_commands_sorted[batch_start];
+			for (uint32_t i = 0; i < batch_command_count; i++) {
