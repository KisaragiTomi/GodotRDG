+void RenderingDeviceGraph::_open_queue_batch(CommandQueueType p_queue_type, int32_t p_wait_batch) {
+	DEV_ASSERT(queue_current_batch[p_queue_type] < 0);
+
+	QueueBatch batch;
+	batch.queue_type = p_queue_type;
+	batch.wait_batch = p_wait_batch;
+	queue_current_batch[p_queue_type] = queue_batches.size();
+	queue_last_batch[p_queue_type] = queue_batches.size();
+	queue_batches.push_back(batch);
+
+	if (p_wait_batch >= 0) {
+		DEV_ASSERT(queue_batches[p_wait_batch].queue_type != p_queue_type);
+		DEV_ASSERT(!queue_batches[p_wait_batch].signaled);
+		queue_batches[p_wait_batch].signaled = true;
+		queue_waited_batch[p_queue_type] = p_wait_batch;
+	}
+}
+
+void RenderingDeviceGraph::_close_queue_batch(CommandQueueType p_queue_type) {
+	int32_t &current_batch = queue_current_batch[p_queue_type];
+	if (current_batch >= 0) {
+		// Batches are submitted in the order they're closed: a batch is always closed before any batch waits for it.
+		queue_batches[current_batch].order = queue_batch_order.size();
+		queue_batch_order.push_back(current_batch);
+		current_batch = -1;
+	}
+}
+
+void RenderingDeviceGraph::_assign_command_queue_batch(RecordedCommand *r_command) {
+	const CommandQueueType queue_type = r_command->queue_type;
+	const CommandQueueType other_queue_type = queue_type == COMMAND_QUEUE_TYPE_MAIN ? COMMAND_QUEUE_TYPE_ASYNC_COMPUTE : COMMAND_QUEUE_TYPE_MAIN;
+	const int32_t wait_batch = MAX(command_cross_queue_wait, queue_pending_wait[queue_type]);
+	if (wait_batch > queue_waited_batch[queue_type]) {
+		// The command needs commands of the other queue this queue doesn't wait for yet. End the batch of the other queue
+		// so it can signal, and start a new batch that waits for it. Commands already recorded on this queue don't wait.
+		if (queue_current_batch[other_queue_type] == wait_batch) {
+			_close_queue_batch(other_queue_type);
+		}
+
+		_close_queue_batch(queue_type);
+		_open_queue_batch(queue_type, wait_batch);
+	} else if (queue_current_batch[queue_type] < 0) {
+		_open_queue_batch(queue_type, -1);
+	}
+
+	queue_pending_wait[queue_type] = -1;
+	r_command->queue_batch = queue_current_batch[queue_type];
+	queue_batches[r_command->queue_batch].command_count++;
+
+	if (queue_type == COMMAND_QUEUE_TYPE_ASYNC_COMPUTE) {
+		async_compute_command_count++;
+	}
+}
+
+void RenderingDeviceGraph::_close_queue_batches_for_end() {
+	const int32_t last_async_compute_batch = queue_last_batch[COMMAND_QUEUE_TYPE_ASYNC_COMPUTE];
+	_close_queue_batch(COMMAND_QUEUE_TYPE_ASYNC_COMPUTE);
+	if (last_async_compute_batch > queue_waited_batch[COMMAND_QUEUE_TYPE_MAIN]) {
+		// Join the async compute work before the end of the frame: the frame's fence then covers both queues, and the
+		// next frames can't run main queue work that overlaps with it.
+		_close_queue_batch(COMMAND_QUEUE_TYPE_MAIN);
+		_open_queue_batch(COMMAND_QUEUE_TYPE_MAIN, last_async_compute_batch);
+	}
+
+	_close_queue_batch(COMMAND_QUEUE_TYPE_MAIN);
+}
