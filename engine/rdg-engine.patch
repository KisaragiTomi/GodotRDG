+bool RenderingDeviceDriverVulkan::_probe_placed_memory_type() {
+	if (placed_memory_type_probed) {
+		return placed_memory_type_index != UINT32_MAX;
+	}
+	placed_memory_type_probed = true;
+
+	// Probe the memory types accepted by a typical render target / UAV texture and a typical storage buffer.
+	VkImageCreateInfo image_create_info = {};
+	image_create_info.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO;
+	image_create_info.imageType = VK_IMAGE_TYPE_2D;
+	image_create_info.format = VK_FORMAT_R16G16B16A16_SFLOAT;
+	image_create_info.extent = { 256, 256, 1 };
+	image_create_info.mipLevels = 1;
+	image_create_info.arrayLayers = 1;
+	image_create_info.samples = VK_SAMPLE_COUNT_1_BIT;
+	image_create_info.tiling = VK_IMAGE_TILING_OPTIMAL;
+	image_create_info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	_set_resource_sharing_mode(image_create_info.sharingMode, image_create_info.queueFamilyIndexCount, image_create_info.pQueueFamilyIndices);
+	image_create_info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+
+	VkImage vk_image = VK_NULL_HANDLE;
+	VkResult err = vkCreateImage(vk_device, &image_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE), &vk_image);
+	ERR_FAIL_COND_V_MSG(err, false, "vkCreateImage failed with error " + itos(err) + " while probing memory types for placed resources.");
+	VkMemoryRequirements image_requirements = {};
+	vkGetImageMemoryRequirements(vk_device, vk_image, &image_requirements);
+	vkDestroyImage(vk_device, vk_image, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_IMAGE));
+
+	VkBufferCreateInfo buffer_create_info = {};
+	buffer_create_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+	buffer_create_info.size = 65536;
+	buffer_create_info.usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_INDIRECT_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+	_set_resource_sharing_mode(buffer_create_info.sharingMode, buffer_create_info.queueFamilyIndexCount, buffer_create_info.pQueueFamilyIndices);
+
+	VkBuffer vk_buffer = VK_NULL_HANDLE;
+	err = vkCreateBuffer(vk_device, &buffer_create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER), &vk_buffer);
+	ERR_FAIL_COND_V_MSG(err, false, "vkCreateBuffer failed with error " + itos(err) + " while probing memory types for placed resources.");
+	VkMemoryRequirements buffer_requirements = {};
+	vkGetBufferMemoryRequirements(vk_device, vk_buffer, &buffer_requirements);
+	vkDestroyBuffer(vk_device, vk_buffer, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER));
+
+	// Prefer a type shared by textures and buffers. Otherwise heaps only hold textures and buffers can't be placed.
+	VmaAllocationCreateInfo alloc_create_info = {};
+	alloc_create_info.requiredFlags = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;
+	uint32_t memory_type_index = UINT32_MAX;
+	const uint32_t shared_type_bits = image_requirements.memoryTypeBits & buffer_requirements.memoryTypeBits;
+	if (shared_type_bits && vmaFindMemoryTypeIndex(allocator, shared_type_bits, &alloc_create_info, &memory_type_index) == VK_SUCCESS) {
+		placed_buffers_supported = true;
+	} else if (vmaFindMemoryTypeIndex(allocator, image_requirements.memoryTypeBits, &alloc_create_info, &memory_type_index) != VK_SUCCESS) {
+		memory_type_index = UINT32_MAX;
+	}
+
+	placed_memory_type_index = memory_type_index;
+	print_verbose(vformat("Vulkan: placed resources use memory type %d (buffers %s).", int(memory_type_index), placed_buffers_supported ? "supported" : "not supported"));
+	return placed_memory_type_index != UINT32_MAX;
+}
+
+RDD::MemoryHeapID RenderingDeviceDriverVulkan::memory_heap_create(uint64_t p_size) {
+	if (!_probe_placed_memory_type()) {
+		return MemoryHeapID();
+	}
+
+	VkMemoryRequirements memory_requirements = {};
+	memory_requirements.size = p_size;
+	memory_requirements.alignment = 65536;
+	memory_requirements.memoryTypeBits = 1u << placed_memory_type_index;
+
+	// A heap is one dedicated device memory block, placed resources are bound at offsets inside it.
+	VmaAllocationCreateInfo alloc_create_info = {};
+	alloc_create_info.flags = VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT;
+	alloc_create_info.memoryTypeBits = memory_requirements.memoryTypeBits;
+
+	VmaAllocation allocation = nullptr;
+	VkResult err = vmaAllocateMemory(allocator, &memory_requirements, &alloc_create_info, &allocation, nullptr);
+	ERR_FAIL_COND_V_MSG(err, MemoryHeapID(), "vmaAllocateMemory failed with error " + itos(err) + " for a memory heap of " + itos(p_size) + " bytes.");
+
+	MemoryHeapInfo *heap_info = VersatileResource::allocate<MemoryHeapInfo>(resources_allocator);
+	heap_info->allocation = allocation;
+	heap_info->size = p_size;
+	return MemoryHeapID(heap_info);
+}
+
+void RenderingDeviceDriverVulkan::memory_heap_free(MemoryHeapID p_heap) {
+	MemoryHeapInfo *heap_info = (MemoryHeapInfo *)p_heap.id;
+	vmaFreeMemory(allocator, heap_info->allocation);
+	VersatileResource::free(resources_allocator, heap_info);
+}
