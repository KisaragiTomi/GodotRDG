+		tracker->aliasing_stages = tracker->aliasing_stages | overlap->current_frame_stages | overlap->previous_frame_stages;
+
+		// Every command of this frame that used the overlapping resource is either one of its last writers, a reader
+		// recorded after them, or already ordered before them, so depending on these is enough.
+		if (overlap->write_command_or_list_index >= 0) {
+			if (overlap->write_command_list_enabled) {
+				int32_t write_list_index = overlap->write_command_or_list_index;
+				while (write_list_index >= 0) {
