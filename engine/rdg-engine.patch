+void RenderingDeviceGraph::_sanitize_barrier_group_for_async_compute(BarrierGroup &r_barrier_group) {
+	const auto sanitize_stages = [](BitField<RDD::PipelineStageBits> &r_stages) {
+		const uint32_t stages = uint32_t(r_stages);
+		if ((stages & ~ASYNC_COMPUTE_PIPELINE_STAGES) != 0) {
+			r_stages = BitField<RDD::PipelineStageBits>((stages & ASYNC_COMPUTE_PIPELINE_STAGES) | RDD::PIPELINE_STAGE_ALL_COMMANDS_BIT);
+		}
+	};
+
+	const auto sanitize_access = [](BitField<RDD::BarrierAccessBits> &r_access) {
+		r_access = BitField<RDD::BarrierAccessBits>(uint32_t(r_access) & ASYNC_COMPUTE_BARRIER_ACCESS);
+	};
+
+	sanitize_stages(r_barrier_group.src_stages);
+	sanitize_stages(r_barrier_group.dst_stages);
+	sanitize_access(r_barrier_group.memory_barrier.src_access);
+	sanitize_access(r_barrier_group.memory_barrier.dst_access);
+
+	for (RDD::TextureBarrier &texture_barrier : r_barrier_group.normalization_barriers) {
+		sanitize_access(texture_barrier.src_access);
+		sanitize_access(texture_barrier.dst_access);
+	}
+
+	for (RDD::TextureBarrier &texture_barrier : r_barrier_group.transition_barriers) {
+		sanitize_access(texture_barrier.src_access);
+		sanitize_access(texture_barrier.dst_access);
+	}
+
+#if USE_BUFFER_BARRIERS
+	for (RDD::BufferBarrier &buffer_barrier : r_barrier_group.buffer_barriers) {
+		sanitize_access(buffer_barrier.src_access);
+		sanitize_access(buffer_barrier.dst_access);
+	}
+#endif
+}
