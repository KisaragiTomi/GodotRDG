+	if (!tracker->aliasing_pending || tracker->aliasing_frame != tracking_frame) {
+		tracker->aliasing_command_list_index = -1;
+	}
+
+	tracker->aliasing_pending = true;
+	tracker->aliasing_frame = tracking_frame;
+
+	for (uint32_t i = 0; i < p_overlapping_trackers.size(); i++) {
+		ResourceTracker *overlap = p_overlapping_trackers[i];
+		DEV_ASSERT(overlap != nullptr);
+		overlap = overlap->parent != nullptr ? overlap->parent : overlap;
+		if (overlap == tracker) {
+			continue;
+		}
+
