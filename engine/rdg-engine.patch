+void RenderingDeviceDriverVulkan::command_queue_family_set_resource_sharing(VectorView<CommandQueueFamilyID> p_cmd_queue_families) {
+	resource_sharing_queue_families.clear();
+	for (uint32_t i = 0; i < p_cmd_queue_families.size(); i++) {
+		DEV_ASSERT(p_cmd_queue_families[i].id != 0);
+		const uint32_t family_index = p_cmd_queue_families[i].id - 1;
+		if (!resource_sharing_queue_families.has(family_index)) {
+			resource_sharing_queue_families.push_back(family_index);
+		}
+	}
+
+	if (resource_sharing_queue_families.size() < 2) {
+		resource_sharing_queue_families.clear();
+	}
+}
+
+void RenderingDeviceDriverVulkan::_set_resource_sharing_mode(VkSharingMode &r_sharing_mode, uint32_t &r_queue_family_index_count, const uint32_t *&r_queue_family_indices) const {
+	if (resource_sharing_queue_families.is_empty()) {
+		r_sharing_mode = VK_SHARING_MODE_EXCLUSIVE;
+		r_queue_family_index_count = 0;
+		r_queue_family_indices = nullptr;
+	} else {
+		// Same as UE's Vulkan RHI with r.Vulkan.AllowConcurrentImage / Buffer: resources used by several queues don't need ownership transfers.
+		r_sharing_mode = VK_SHARING_MODE_CONCURRENT;
+		r_queue_family_index_count = resource_sharing_queue_families.size();
+		r_queue_family_indices = resource_sharing_queue_families.ptr();
+	}
+}
