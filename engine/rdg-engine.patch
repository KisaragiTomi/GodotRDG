+					tracker->aliasing_command_list_index = _add_to_command_list(write_list_node.command_index, tracker->aliasing_command_list_index);
+					write_list_index = write_list_node.next_list_index;
+				}
+			} else {
+				tracker->aliasing_command_list_index = _add_to_command_list(overlap->write_command_or_list_index, tracker->aliasing_command_list_index);
+			}
+		}
+
+		int32_t read_full_list_index = overlap->read_full_command_list_index;
+		while (read_full_list_index >= 0) {
+			const RecordedCommandListNode &read_list_node = command_list_nodes[read_full_list_index];
+			tracker->aliasing_command_list_index = _add_to_command_list(read_list_node.command_index, tracker->aliasing_command_list_index);
+			read_full_list_index = read_list_node.next_list_index;
+		}
+
