+RID RenderingDevice::storage_buffer_create_placed(uint32_t p_size_bytes, BitField<StorageBufferUsage> p_usage, RID p_heap, uint64_t p_offset) {
+	const MemoryHeap *heap = memory_heap_owner.get_or_null(p_heap);
+	ERR_FAIL_NULL_V_MSG(heap, RID(), "Invalid memory heap.");
+
+	Buffer buffer;
+	buffer.size = p_size_bytes;
+	buffer.usage = _storage_buffer_driver_usage(p_usage);
+	buffer.driver_id = driver->buffer_create_placed(buffer.size, buffer.usage, heap->driver_id, p_offset);
+	ERR_FAIL_COND_V(!buffer.driver_id, RID());
+
+	// Storage buffers are assumed to be mutable. The memory is accounted for by the heap.
+	buffer.draw_tracker = RDG::resource_tracker_create();
+	buffer.draw_tracker->buffer_driver_id = buffer.driver_id;
+
+	RID id = storage_buffer_owner.make_rid(buffer);
+#ifdef DEV_ENABLED
+	set_resource_name(id, "RID:" + itos(id.get_id()));
+#endif
+	_add_dependency(id, p_heap);
+	return id;
+}
