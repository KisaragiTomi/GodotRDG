+			OPERATION_ALIASING_ACQUIRE,
+			OPERATION_CALLBACK,
+		};
+
+		struct Operation {
+			OperationType type = OPERATION_CALLBACK;
+			uint32_t index = 0;
+		};
+
+		struct Label {
+			uint32_t offset = 0;
+			uint32_t size = 0;
+			Color color;
+		};
+
+		struct AliasingAcquire {
+			ResourceTracker *tracker = nullptr;
+			LocalVector<ResourceTracker *> overlapping_trackers;
