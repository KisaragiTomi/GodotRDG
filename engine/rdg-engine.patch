+/****************************/
+/**** PARALLEL RECORDING ****/
+/****************************/
+
+thread_local RenderingDevice::RecordingContext *RenderingDevice::current_recording_context = nullptr;
+
+RenderingDevice::ListState &RenderingDevice::_get_list_state() {
+	return _is_recording_context_bound() ? current_recording_context->list_state : main_list_state;
+}
+
+RenderingDevice::RecordingContext *RenderingDevice::recording_context_create() {
+	RecordingContext *context = memnew(RecordingContext);
+	context->device = this;
+	return context;
+}
+
+void RenderingDevice::recording_context_free(RecordingContext *p_context) {
+	ERR_FAIL_NULL(p_context);
+	ERR_FAIL_COND_MSG(current_recording_context == p_context, "Can't free a recording context that is bound to the calling thread.");
+	ERR_FAIL_COND_MSG(!p_context->graph_context.is_empty(), "Freeing a recording context that was never submitted, its commands are lost.");
+	memdelete(p_context);
+}
+
+void RenderingDevice::recording_context_begin(RecordingContext *p_context) {
+	ERR_FAIL_NULL(p_context);
+	ERR_FAIL_COND_MSG(p_context->device != this, "The recording context belongs to another RenderingDevice.");
+	ERR_FAIL_COND_MSG(current_recording_context != nullptr, "A recording context is already bound to this thread.");
+	ERR_FAIL_COND_MSG(Thread::get_caller_id() == render_thread_id && main_list_state.draw_list.active, "Can't bind a recording context while a draw list is active on the render thread.");
+	ERR_FAIL_COND_MSG(Thread::get_caller_id() == render_thread_id && main_list_state.compute_list.active, "Can't bind a recording context while a compute list is active on the render thread.");
+
+	current_recording_context = p_context;
+	draw_graph.set_recording_context(&p_context->graph_context);
+}
+
+void RenderingDevice::recording_context_end() {
+	ERR_FAIL_COND_MSG(!_is_recording_context_bound(), "No recording context of this device is bound to the calling thread.");
+	ERR_FAIL_COND_MSG(current_recording_context->list_state.draw_list.active, "A draw list is still active in the recording context.");
+	ERR_FAIL_COND_MSG(current_recording_context->list_state.compute_list.active, "A compute list is still active in the recording context.");
+
+	draw_graph.set_recording_context(nullptr);
+	current_recording_context = nullptr;
+}
+
+RenderingDevice::RecordingContext *RenderingDevice::recording_context_get_current() const {
+	return _is_recording_context_bound() ? current_recording_context : nullptr;
+}
+
+void RenderingDevice::recording_context_add_callback(RDG::DeferredCallback p_callback, void *p_object, uint64_t p_data) {
+	ERR_FAIL_NULL(p_callback);
+	if (!_is_recording_context_bound()) {
+		ERR_RENDER_THREAD_GUARD();
+		p_callback(p_object, p_data);
+		return;
+	}
+
+	current_recording_context->graph_context.add_callback(p_callback, p_object, p_data);
+}
+
+void RenderingDevice::recording_context_submit(RecordingContext *p_context) {
+	ERR_RENDER_THREAD_GUARD();
+	ERR_FAIL_NULL(p_context);
+	ERR_FAIL_COND_MSG(p_context->device != this, "The recording context belongs to another RenderingDevice.");
+	ERR_FAIL_COND_MSG(current_recording_context != nullptr, "Can't submit while a recording context is bound to the render thread.");
+	ERR_FAIL_COND_MSG(main_list_state.draw_list.active || main_list_state.compute_list.active, "Can't submit a recording context while a list is active on the render thread.");
+	ERR_FAIL_COND_MSG(p_context->list_state.draw_list.active || p_context->list_state.compute_list.active, "The recording context still has an active list (recording_context_end() was not called).");
+
+	draw_graph.submit_recording_context(&p_context->graph_context);
+}
+
+bool RenderingDevice::_defer_to_recording_context(RDG::DeferredCallback p_callback, RID p_rid) {
+	if (!_is_recording_context_bound()) {
+		return false;
+	}
+
+	current_recording_context->graph_context.add_callback(p_callback, this, p_rid.get_id());
+	return true;
+}
+
+void RenderingDevice::_deferred_texture_check_pending_clear(void *p_device, uint64_t p_texture) {
+	RenderingDevice *device = static_cast<RenderingDevice *>(p_device);
+	const RID texture_rid = RID::from_uint64(p_texture);
+	Texture *texture = device->texture_owner.get_or_null(texture_rid);
+	if (texture != nullptr) {
+		device->_texture_check_pending_clear(texture_rid, texture);
+	}
+}
+
+void RenderingDevice::_deferred_texture_update_shared_fallback_for_writing(void *p_device, uint64_t p_texture) {
+	RenderingDevice *device = static_cast<RenderingDevice *>(p_device);
+	const RID texture_rid = RID::from_uint64(p_texture);
+	Texture *texture = device->texture_owner.get_or_null(texture_rid);
+	if (texture != nullptr) {
+		device->_texture_update_shared_fallback(texture_rid, texture, true);
+	}
+}
+
+void RenderingDevice::_deferred_uniform_set_update(void *p_device, uint64_t p_uniform_set) {
+	RenderingDevice *device = static_cast<RenderingDevice *>(p_device);
+	UniformSet *uniform_set = device->uniform_set_owner.get_or_null(RID::from_uint64(p_uniform_set));
+	if (uniform_set != nullptr) {
+		device->_uniform_set_update_shared(uniform_set);
+		device->_uniform_set_update_clears(uniform_set);
+	}
+}
