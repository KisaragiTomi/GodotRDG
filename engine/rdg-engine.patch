+void RenderingDeviceGraph::add_aliasing_acquire(ResourceTracker *p_tracker, VectorView<ResourceTracker *> p_overlapping_trackers) {
+	DEV_ASSERT(p_tracker != nullptr);
+
+	RecordingContext *context = _get_recording_context();
+	if (context != nullptr) {
+		// The overlapping commands are only known once the commands recorded before are in the graph.
+		if (context->aliasing_acquires.size() <= context->aliasing_acquire_count) {
+			context->aliasing_acquires.resize(context->aliasing_acquire_count + 1);
