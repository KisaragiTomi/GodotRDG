+uint64_t RenderingDeviceDriverVulkan::_buffer_aligned_size(uint64_t p_size, BitField<BufferUsageBits> p_usage) const {
+	// Same alignment rules as buffer_create().
+	uint32_t alignment = 16u;
+	if (p_usage.has_flag(BUFFER_USAGE_UNIFORM_BIT)) {
+		alignment = MAX(alignment, physical_device_properties.limits.minUniformBufferOffsetAlignment);
+	}
+	if (p_usage.has_flag(BUFFER_USAGE_STORAGE_BIT)) {
+		alignment = MAX(alignment, physical_device_properties.limits.minStorageBufferOffsetAlignment);
+	}
+	return STEPIFY(p_size, alignment);
+}
+
+bool RenderingDeviceDriverVulkan::buffer_get_memory_requirements(uint64_t p_size, BitField<BufferUsageBits> p_usage, MemoryRequirements *r_requirements) {
+	ERR_FAIL_NULL_V(r_requirements, false);
+	ERR_FAIL_COND_V_MSG(p_usage.has_flag(BUFFER_USAGE_DYNAMIC_PERSISTENT_BIT), false, "Dynamic persistent buffers can't be placed in a memory heap.");
+	if (!_probe_placed_memory_type() || !placed_buffers_supported) {
+		return false;
+	}
+
+	VkBufferCreateInfo create_info = {};
+	create_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+	create_info.size = _buffer_aligned_size(p_size, p_usage);
+	create_info.usage = p_usage & ~BUFFER_USAGE_DYNAMIC_PERSISTENT_BIT;
+	_set_resource_sharing_mode(create_info.sharingMode, create_info.queueFamilyIndexCount, create_info.pQueueFamilyIndices);
+
+	VkBuffer vk_buffer = VK_NULL_HANDLE;
+	VkResult err = vkCreateBuffer(vk_device, &create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER), &vk_buffer);
+	ERR_FAIL_COND_V_MSG(err, false, "vkCreateBuffer failed with error " + itos(err) + ".");
+	VkMemoryRequirements memory_requirements = {};
+	vkGetBufferMemoryRequirements(vk_device, vk_buffer, &memory_requirements);
+	vkDestroyBuffer(vk_device, vk_buffer, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER));
+
+	if (!(memory_requirements.memoryTypeBits & (1u << placed_memory_type_index))) {
+		return false;
+	}
+
+	// Buffers and optimal-tiling images share heaps, so keep every placement on a bufferImageGranularity boundary.
+	r_requirements->size = STEPIFY(memory_requirements.size, physical_device_properties.limits.bufferImageGranularity);
+	r_requirements->alignment = MAX(memory_requirements.alignment, physical_device_properties.limits.bufferImageGranularity);
+	return true;
+}
+
+RDD::BufferID RenderingDeviceDriverVulkan::buffer_create_placed(uint64_t p_size, BitField<BufferUsageBits> p_usage, MemoryHeapID p_heap, uint64_t p_offset) {
+	ERR_FAIL_COND_V_MSG(p_usage.has_flag(BUFFER_USAGE_DYNAMIC_PERSISTENT_BIT), BufferID(), "Dynamic persistent buffers can't be placed in a memory heap.");
+	const MemoryHeapInfo *heap_info = (const MemoryHeapInfo *)p_heap.id;
+	ERR_FAIL_NULL_V(heap_info, BufferID());
+
+	const uint64_t size = _buffer_aligned_size(p_size, p_usage);
+	VkBufferCreateInfo create_info = {};
+	create_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+	create_info.size = size;
+	create_info.usage = p_usage & ~BUFFER_USAGE_DYNAMIC_PERSISTENT_BIT;
+	_set_resource_sharing_mode(create_info.sharingMode, create_info.queueFamilyIndexCount, create_info.pQueueFamilyIndices);
+
+	VkBuffer vk_buffer = VK_NULL_HANDLE;
+	VkResult err = vkCreateBuffer(vk_device, &create_info, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER), &vk_buffer);
+	ERR_FAIL_COND_V_MSG(err, BufferID(), "vkCreateBuffer failed with error " + itos(err) + ".");
+
+	VkMemoryRequirements memory_requirements = {};
+	vkGetBufferMemoryRequirements(vk_device, vk_buffer, &memory_requirements);
+	if (!(memory_requirements.memoryTypeBits & (1u << placed_memory_type_index)) || (p_offset % memory_requirements.alignment) != 0 || p_offset + memory_requirements.size > heap_info->size) {
+		vkDestroyBuffer(vk_device, vk_buffer, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER));
+		ERR_FAIL_V_MSG(BufferID(), vformat("Buffer of %d bytes can't be placed at offset %d of a %d bytes memory heap.", size, p_offset, heap_info->size));
+	}
+
+	err = vmaBindBufferMemory2(allocator, heap_info->allocation, p_offset, vk_buffer, nullptr);
+	if (err) {
+		vkDestroyBuffer(vk_device, vk_buffer, VKC::get_allocation_callbacks(VK_OBJECT_TYPE_BUFFER));
+		ERR_FAIL_V_MSG(BufferID(), "vmaBindBufferMemory2 failed with error " + itos(err) + ".");
+	}
+
+	// A null allocation handle makes buffer_free() destroy the VkBuffer without touching the heap memory.
+	BufferInfo *buf_info = VersatileResource::allocate<BufferInfo>(resources_allocator);
+	buf_info->vk_buffer = vk_buffer;
+	buf_info->allocation.handle = nullptr;
+	buf_info->allocation.size = size;
+	buf_info->size = size;
+	return BufferID(buf_info);
+}
