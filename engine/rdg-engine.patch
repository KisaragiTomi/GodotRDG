+/**********************/
+
+RID RenderingDevice::memory_heap_create(uint64_t p_size_bytes) {
+	ERR_FAIL_COND_V(p_size_bytes == 0, RID());
+
+	MemoryHeap heap;
+	heap.size = p_size_bytes;
+	heap.driver_id = driver->memory_heap_create(p_size_bytes);
+	if (!heap.driver_id) {
+		return RID();
+	}
+
+	_THREAD_SAFE_LOCK_
+	memory_heap_memory += p_size_bytes;
+	_THREAD_SAFE_UNLOCK_
+
+	RID id = memory_heap_owner.make_rid(heap);
+#ifdef DEV_ENABLED
+	set_resource_name(id, "RID:" + itos(id.get_id()));
+#endif
+	return id;
+}
+
+bool RenderingDevice::memory_heap_is_valid(RID p_heap) {
+	_THREAD_SAFE_METHOD_
+	return memory_heap_owner.owns(p_heap);
+}
+
+uint64_t RenderingDevice::memory_heap_get_size(RID p_heap) {
+	_THREAD_SAFE_METHOD_
+	const MemoryHeap *heap = memory_heap_owner.get_or_null(p_heap);
+	ERR_FAIL_NULL_V(heap, 0);
+	return heap->size;
+}
+
+RDG::ResourceTracker *RenderingDevice::_get_resource_tracker(RID p_resource) {
+	if (texture_owner.owns(p_resource)) {
+		Texture *texture = texture_owner.get_or_null(p_resource);
+		if (texture->owner.is_valid()) {
+			texture = texture_owner.get_or_null(texture->owner);
+			ERR_FAIL_NULL_V(texture, nullptr);
+		}
+		return texture->draw_tracker;
+	}
+
+	Buffer *buffer = _get_buffer_from_owner(p_resource);
+	return buffer != nullptr ? buffer->draw_tracker : nullptr;
+}
+
+void RenderingDevice::resource_aliasing_acquire(RID p_resource, VectorView<RID> p_overlapping_resources) {
+	ERR_RENDER_THREAD_GUARD();
+
+	RDG::ResourceTracker *tracker = _get_resource_tracker(p_resource);
+	ERR_FAIL_NULL_MSG(tracker, "Aliasing can only be acquired on mutable textures and buffers.");
+
+	thread_local LocalVector<RDG::ResourceTracker *> overlapping_trackers;
+	overlapping_trackers.clear();
+	for (uint32_t i = 0; i < p_overlapping_resources.size(); i++) {
+		RDG::ResourceTracker *overlapping_tracker = _get_resource_tracker(p_overlapping_resources[i]);
+		ERR_CONTINUE_MSG(overlapping_tracker == nullptr, "Overlapping resource is not a mutable texture or buffer.");
+		overlapping_trackers.push_back(overlapping_tracker);
+	}
+
+	draw_graph.add_aliasing_acquire(tracker, overlapping_trackers);
+}
