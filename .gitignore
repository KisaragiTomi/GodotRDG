# Godot editor cache
.godot/

# Generated by modules/rdg/SCsub from the embedded shaders
modules/rdg/Private/RDGEmbeddedShaders.gen.h

# Python bytecode (config.py / SCsub)
__pycache__/
*.pyc

# Downloaded / generated data, recreated with tools/download-sponza.py + tools/prepare-sponza.ps1
/generated/
/assets/sponza/glTF/
*.partial

# Validation captures and logs (tools/*.ps1); the .gdignore keeps Godot from importing them
/artifacts/*
!/artifacts/.gdignore

# Machine-local tooling and credentials
/.venv/
.env
.env.*
*.pem
*.key
.DS_Store
Thumbs.db
