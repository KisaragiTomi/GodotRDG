// Shared probe positions for the legacy screen-space regression reference.
// Jitter is stable per probe/cascade and identical for every angular direction.
float legacy_hash12(vec2 p) {
	vec3 p3 = fract(vec3(p.xyx) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return fract((p3.x + p3.y) * p3.z);
}

vec2 legacy_probe_position(ivec2 probe, int cascade, int spacing, ivec2 screen_size) {
	vec2 seed = vec2(probe.x * 73, probe.y * 137 + cascade);
	vec2 jitter = vec2(legacy_hash12(seed), legacy_hash12(seed + vec2(71.0, 31.0))) - 0.5;
	vec2 position = (vec2(probe) + 0.5 + jitter * 0.3) * float(spacing);
	return clamp(position, vec2(0.5), vec2(screen_size) - 0.5);
}

// Normalized by the caller, using the actual jittered sample positions.
float legacy_probe_weight(vec2 position, vec2 probe_position, int spacing) {
	vec2 tent = max(vec2(0.0), vec2(1.0) - abs(position - probe_position) / float(spacing));
	return tent.x * tent.y;
}
