#!/usr/bin/env python
from misc.utility.scons_hints import *

import os

Import("env")
Import("env_modules")

env_rdg = env_modules.Clone()

# Mirror UE's RenderCore layout: headers in Public/, implementation in Private/.
# Public/ is added to the include path so code can write `#include "RenderGraphBuilder.h"` like in UE.
env_rdg.Prepend(CPPPATH=[Dir("Public").abspath, Dir("Private").abspath, Dir(".").abspath])

module_dir = Dir(".").srcnode().abspath

# Embedded shaders: Shaders/<path> is served as "/Engine/<path>", Tests/Shaders/<path> as "/RDGTests/<path>".
shader_roots = [("Shaders", "/Engine/"), (os.path.join("Tests", "Shaders"), "/RDGTests/")]
shader_sources = []
for folder, _ in shader_roots:
    root = os.path.join(module_dir, folder)
    for current, _, files in os.walk(root):
        for name in sorted(files):
            if name.endswith(".glsl"):
                shader_sources.append(os.path.join(current, name))


def make_embedded_shaders(target, source, env):
    with open(str(target[0]), "w", encoding="utf-8", newline="\n") as out:
        out.write("// Generated by modules/rdg/SCsub from Shaders/ and Tests/Shaders/. Do not edit.\n")
        out.write("#pragma once\n\n#include \"GlobalShader.h\"\n\n")
        entries = []
        for index, node in enumerate(source):
            path = str(node.srcnode().abspath)
            relative = os.path.relpath(path, module_dir).replace("\\", "/")
            virtual = None
            for folder, prefix in shader_roots:
                folder_prefix = folder.replace("\\", "/") + "/"
                if relative.startswith(folder_prefix):
                    virtual = prefix + relative[len(folder_prefix) :]
                    break
            with open(path, "rb") as f:
                data = f.read().replace(b"\r\n", b"\n")
            out.write("static const char RDGEmbeddedShader%d[] = {" % index)
            for i, byte in enumerate(data):
                if i % 24 == 0:
                    out.write("\n\t")
                out.write("%d," % byte)
            out.write("\n\t0\n};\n\n")
            entries.append((virtual, index))
        out.write("inline void RegisterRDGEmbeddedShaders() {\n")
        for virtual, index in entries:
            out.write('\tRDGShaderSource::RegisterEmbeddedShader("%s", RDGEmbeddedShader%d);\n' % (virtual, index))
        out.write("}\n")


env_rdg.CommandNoCache(
    os.path.join(module_dir, "Private", "RDGEmbeddedShaders.gen.h"),
    [File(path) for path in shader_sources],
    env.Run(make_embedded_shaders),
)

env_rdg.add_source_files(env.modules_sources, "*.cpp")
env_rdg.add_source_files(env.modules_sources, "Private/*.cpp")
env_rdg.add_source_files(env.modules_sources, "Tests/*.cpp")
env_rdg.add_source_files(env.modules_sources, "Demo/*.cpp")
